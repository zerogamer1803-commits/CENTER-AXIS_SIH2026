#include <SPI.h>
#include <LoRa.h>

// =====================================
// LoRa Pins - Arduino UNO
// =====================================
#define LORA_SS    10
#define LORA_RST   9
#define LORA_DIO0  2

#define LORA_FREQ  433E6

// =====================================
// Solar Voltage Sensor
// =====================================
#define SOLAR_VOLTAGE_PIN A0

int packetNumber = 0;


// =====================================
// Read Solar Voltage
// =====================================
float readSolarVoltage() {

  int adcValue = analogRead(SOLAR_VOLTAGE_PIN);

  float sensorVoltage = adcValue * (5.0 / 1023.0);

  // For common 0-25V voltage sensor
  float solarVoltage = sensorVoltage * 5.0;

  return solarVoltage;
}


// =====================================
// SETUP
// =====================================
void setup() {

  Serial.begin(9600);

  delay(1000);

  Serial.println();
  Serial.println("================================");
  Serial.println("ARDUINO UNO SOLAR TRANSMITTER");
  Serial.println("================================");

  // =====================================
  // Start LoRa
  // =====================================
  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);

  Serial.println("Starting LoRa...");

  if (!LoRa.begin(LORA_FREQ)) {

    Serial.println("LoRa FAILED!");

    while (1) {
      delay(1000);
    }
  }

  // Same settings as ESP32 receiver
  LoRa.setSpreadingFactor(12);
  LoRa.setSignalBandwidth(125E3);
  LoRa.setCodingRate4(8);

  Serial.println("LoRa TX Started");
  Serial.println("Frequency = 433 MHz");
  Serial.println("SF = 12");
  Serial.println("BW = 125 kHz");
  Serial.println("CR = 4/8");
  Serial.println();
  Serial.println("Sending solar voltage...");
}


// =====================================
// LOOP
// =====================================
void loop() {

  // =====================================
  // Read Solar Voltage
  // =====================================
  float solarVoltage = readSolarVoltage();


  // =====================================
  // Show on Arduino Serial Monitor
  // =====================================
  Serial.println();
  Serial.println("------------------------------");

  Serial.print("Solar Voltage: ");
  Serial.print(solarVoltage, 2);
  Serial.println(" V");


  // =====================================
  // Send through LoRa
  // =====================================
  LoRa.beginPacket();

  LoRa.print("ST01");

  LoRa.print(",SOLAR=");
  LoRa.print(solarVoltage, 2);

  LoRa.print(",PKT=");
  LoRa.print(packetNumber);

  LoRa.endPacket();


  // =====================================
  // Transmission Status
  // =====================================
  Serial.print("Packet sent: ");
  Serial.println(packetNumber);

  Serial.println("------------------------------");


  packetNumber++;

  if (packetNumber > 100) {
    packetNumber = 0;
  }


  // Send every 1 second
  delay(1000);
}
