#include <SPI.h>
#include <LoRa.h>
#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>

// =====================================
// Wi-Fi
// =====================================
const char* WIFI_SSID = "Ram";
const char* WIFI_PASSWORD = "11111111";

// =====================================
// Django API
// =====================================
const char* API_URL =
  "https://renewable-energy-backend-rt5h.onrender.com/api/energy/solar-voltage/";

// =====================================
// ESP32 LoRa Pins
// =====================================
#define LORA_SCK   18
#define LORA_MISO  19
#define LORA_MOSI  23

#define SS    5
#define RST   14
#define DIO0  2

#define LED_PIN 27


// =====================================
// Wi-Fi Connection
// =====================================
void connectWiFi() {

  Serial.println();
  Serial.println("Connecting to Wi-Fi...");

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED && attempts < 30) {

    delay(500);
    Serial.print(".");

    attempts++;
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("Wi-Fi Connected!");

    Serial.print("ESP32 IP: ");
    Serial.println(WiFi.localIP());

  } else {

    Serial.println("Wi-Fi Connection Failed!");

  }
}


// =====================================
// Send Solar Voltage to Django
// =====================================
void sendSolarVoltageToServer(float solarVoltage) {

  if (WiFi.status() != WL_CONNECTED) {

    Serial.println("Wi-Fi not connected.");
    return;
  }

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient http;

  Serial.println();
  Serial.println("Sending solar voltage to server...");

  if (http.begin(client, API_URL)) {

    http.addHeader("Content-Type", "application/json");

    String jsonData =
      "{\"solar_voltage\":" +
      String(solarVoltage, 2) +
      "}";

    Serial.print("JSON: ");
    Serial.println(jsonData);

    int responseCode = http.POST(jsonData);

    Serial.print("HTTP Response Code: ");
    Serial.println(responseCode);

    if (responseCode > 0) {

      String response = http.getString();

      Serial.print("Server Response: ");
      Serial.println(response);

    } else {

      Serial.print("HTTP Error: ");
      Serial.println(http.errorToString(responseCode));

    }

    http.end();

  } else {

    Serial.println("Could not connect to Django API.");

  }
}


// =====================================
// SETUP
// =====================================
void setup() {

  Serial.begin(115200);
  delay(2000);

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  Serial.println();
  Serial.println("================================");
  Serial.println("ESP32 SOLAR LORA + WIFI");
  Serial.println("================================");

  // =====================================
  // Wi-Fi
  // =====================================
  connectWiFi();

  // =====================================
  // SPI
  // =====================================
  SPI.begin(
    LORA_SCK,
    LORA_MISO,
    LORA_MOSI,
    SS
  );

  LoRa.setPins(SS, RST, DIO0);

  // =====================================
  // LoRa
  // =====================================
  Serial.println();
  Serial.println("Starting LoRa...");

  if (!LoRa.begin(433E6)) {

    Serial.println("LoRa FAILED!");

    while (1) {
      delay(1000);
    }
  }

  // Same settings as UNO
  LoRa.setSpreadingFactor(12);
  LoRa.setSignalBandwidth(125E3);
  LoRa.setCodingRate4(8);

  Serial.println("LoRa RX Started");
  Serial.println("Frequency = 433 MHz");
  Serial.println("SF = 12");
  Serial.println("BW = 125 kHz");
  Serial.println("CR = 4/8");

  Serial.println();
  Serial.println("Waiting for solar voltage...");
}


// =====================================
// LOOP
// =====================================
void loop() {

  int packetSize = LoRa.parsePacket();

  if (packetSize > 0) {

    String message = "";

    while (LoRa.available()) {

      message += (char)LoRa.read();

    }

    Serial.println();
    Serial.println("******** SOLAR DATA RECEIVED ********");

    Serial.print("Full Packet: ");
    Serial.println(message);

    // =====================================
    // Find SOLAR=
    // =====================================
    int solarIndex = message.indexOf("SOLAR=");

    if (solarIndex >= 0) {

      int startIndex = solarIndex + 6;

      int endIndex = message.indexOf(",", startIndex);

      String solarValue;

      if (endIndex >= 0) {

        solarValue = message.substring(
          startIndex,
          endIndex
        );

      } else {

        solarValue = message.substring(startIndex);

      }

      // =====================================
      // Convert voltage
      // =====================================
      float solarVoltage = solarValue.toFloat();

      Serial.print("Solar Voltage: ");
      Serial.print(solarVoltage, 2);
      Serial.println(" V");

      // =====================================
      // LoRa signal
      // =====================================
      Serial.print("RSSI: ");
      Serial.print(LoRa.packetRssi());
      Serial.println(" dBm");

      Serial.print("SNR: ");
      Serial.print(LoRa.packetSnr());
      Serial.println(" dB");

      // =====================================
      // Send to Django
      // =====================================
      sendSolarVoltageToServer(solarVoltage);

      // LED
      digitalWrite(LED_PIN, HIGH);
      delay(100);
      digitalWrite(LED_PIN, LOW);

      Serial.println("**************************************");

    } else {

      Serial.println("Solar data not found in packet.");

    }
  }
}
